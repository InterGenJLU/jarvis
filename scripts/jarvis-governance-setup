#!/usr/bin/env python3
"""JARVIS Governance Setup — set the governance password.

Usage:
    python3 scripts/jarvis-governance-setup

Run once to set the password used for confirming governance proposals.
The password hash is stored in governance/.governance_pw.
"""

import getpass
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


def main():
    print("")
    print("=" * 50)
    print("  JARVIS Governance — Password Setup")
    print("=" * 50)
    print("")
    print("This password is used to confirm governance proposals.")
    print("It is required alongside the web-displayed confirmation")
    print("code when approving changes via the console.")
    print("")

    pw1 = getpass.getpass("Set governance password: ")
    if not pw1:
        print("ERROR: Password cannot be empty.")
        sys.exit(1)

    pw2 = getpass.getpass("Confirm password: ")
    if pw1 != pw2:
        print("ERROR: Passwords do not match.")
        sys.exit(1)

    from core.config import Config
    from core.governance import Governance

    config = Config()
    gov = Governance(config)

    if gov.set_password(pw1):
        print("")
        print("  ✓ Governance password set successfully.")
        print("    Hash stored in governance/.governance_pw")
        print("")
    else:
        print("")
        print("  ✗ Failed to set password.")
        sys.exit(1)

    gov.stop()


if __name__ == "__main__":
    main()
